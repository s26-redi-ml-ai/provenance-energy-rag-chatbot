# Environment files and secrets
.env
.env.*
!.env.example
frontend/.streamlit/secrets.toml

# Python virtual environments
.venv/
venv/
env/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Runtime data generated by the RAG app
backend/data/raw/**
backend/data/processed/**
backend/data/vector_store/**
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/vector_store/.gitkeep

# Local databases, vector indexes, and cache files
*.sqlite
*.sqlite3
*.db
*.chroma

# Logs and temporary files
*.log
logs/
tmp/
temp/
.cache/

# Uploaded or local sample documents that may contain private data
*.pdf
*.docx
*.xlsx
*.xls

# Frontend / Node artifacts if the React version is reused later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Streamlit local runtime artifacts
.streamlit/secrets.toml

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Keep lockfiles committed
!backend/uv.lock
!frontend/uv.lock

# Private keys and certificates
*.pem
*.key
*.crt
*.p12
*.p8
*slack
