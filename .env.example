# ---------------------------------------------------------------------------
# Trustworthy Domain-Specific RAG Chatbot With Provenance
# Example environment file.
#
# Copy this file before running locally:
#   cp .env.example .env
#   cp .env.example backend/.env
#
# Do not put real API keys in this file before committing to GitHub.
# ---------------------------------------------------------------------------

# Application
APP_NAME=Trustworthy RAG Chatbot
APP_ENV=development

# CORS is mostly useful if another browser frontend calls the API directly.
# Streamlit calls the backend server-side, but these localhost origins are safe
# for local development and future frontend variants.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173

# Storage
# When running from backend/, this creates backend/data/.
DATA_DIR=data
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=data/vector_store
VECTOR_COLLECTION_NAME=technical_manual_chunks

# LLM generation
# Use mock for local smoke tests and demos without spending API credits.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1
LLM_TEMPERATURE=0

# Example Groq/OpenAI-compatible configuration.
# Uncomment and fill in locally only. Do not commit real keys.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_TEMPERATURE=0

# Embeddings
# sentence-transformers gives better retrieval; hash is useful for fast tests.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_DIMENSION=384

# RAG behavior
CHUNK_SIZE=750
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Keep false by default so document mode refuses unsupported answers.
ALLOW_GENERAL_KNOWLEDGE=true

# Local response cache
# Helps avoid repeated LLM calls for identical questions against unchanged docs.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=604800

# Upload safety
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.md,.markdown

# Streamlit frontend
BACKEND_URL=http://localhost:8000
